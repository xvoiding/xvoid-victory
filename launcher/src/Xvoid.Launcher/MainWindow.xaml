<Window x:Class="Xvoid.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Xvoid.Launcher.Views"
        Title="xvoid Launcher" Icon="Assets/xvoid.ico" Width="1040" Height="680" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource Text}"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource Wash}" IsHitTestVisible="False" />

        <!-- Rail -->
        <Border Grid.Column="0" Background="#99000000" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,22">
                    <!-- The same drawing as the exe icon (launcher/tools/make_icon.py): a gradient stroke crossed by a white one. -->
                    <Border Width="30" Height="30" CornerRadius="8" Background="#0E0E15" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
                        <Viewbox>
                            <Canvas Width="100" Height="100">
                                <Line X1="29" Y1="29" X2="71" Y2="71" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Line.Stroke>
                                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="100,100">
                                            <GradientStop Color="{StaticResource AccentA}" Offset="0" />
                                            <GradientStop Color="{StaticResource AccentB}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Line.Stroke>
                                </Line>
                                <Line X1="71" Y1="29" X2="29" Y2="71" Stroke="#0E0E15" StrokeThickness="23" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="71" Y1="29" X2="29" Y2="71" Stroke="White" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="xvoid" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Launcher" Style="{StaticResource Caption}" Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,0,0,0">
                    <TextBlock Text="ENGINE" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding EngineLabel}" Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Version, StringFormat=Launcher {0}}" Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" />
                </StackPanel>

                <StackPanel shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton Style="{StaticResource RailButton}" Content="Play" Tag="{StaticResource IconPlay}" GroupName="nav" IsChecked="{Binding OnPlay, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Prepare" Tag="{StaticResource IconPrepare}" GroupName="nav" IsChecked="{Binding OnPrepare, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Engine" Tag="{StaticResource IconEngine}" GroupName="nav" IsChecked="{Binding OnEngine, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Settings" Tag="{StaticResource IconSettings}" GroupName="nav" IsChecked="{Binding OnSettings, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource RailButton}" Content="Logs" Tag="{StaticResource IconLogs}" GroupName="nav" IsChecked="{Binding OnLogs, Mode=TwoWay}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Window buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="10">
            <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
                <Path Data="M0,0 H10" Stroke="{StaticResource Dim}" StrokeThickness="1" Width="10" Height="1" Stretch="Fill" />
            </Button>
            <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Close">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Dim}" StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
            </Button>
        </StackPanel>

        <!-- Pages stay loaded so a running log keeps filling. -->
        <Grid Grid.Column="1" Margin="40,52,40,28">
            <views:PlayPage DataContext="{Binding Play}" Visibility="{Binding DataContext.OnPlay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:PreparePage DataContext="{Binding Prepare}" Visibility="{Binding DataContext.OnPrepare, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:EnginePage DataContext="{Binding Engine}" Visibility="{Binding DataContext.OnEngine, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:SettingsPage DataContext="{Binding Settings}" Visibility="{Binding DataContext.OnSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:LogsPage DataContext="{Binding Logs}" Visibility="{Binding DataContext.OnLogs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
