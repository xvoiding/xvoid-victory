<UserControl x:Class="Xvoid.Launcher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource Title}" />

            <!-- Game -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Game" Style="{StaticResource Heading}" />
                    <TextBlock Text="The folder with your own copy of the game's files. The launcher does not include any game files." Style="{StaticResource Caption}" Margin="0,4,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GamePath, Mode=OneWay}" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Choose folder" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseGameCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding GameProblem}" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,8,0,0"
                               Visibility="{Binding GameProblem, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </Border>

            <!-- Engine -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Engine" Style="{StaticResource Heading}" />
                    <TextBlock Text="Which engine plays the game. Both can be installed; the same choice is on the Play and Engine pages." Style="{StaticResource Caption}" Margin="0,4,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="settingsEngine" Content="Auto" IsChecked="{Binding EngineAuto, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="settingsEngine" Content="NVIDIA" IsChecked="{Binding EngineNvidia, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="settingsEngine" Content="AMD" IsChecked="{Binding EngineAmd, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding EngineHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" Foreground="{StaticResource Faint}" />
                </StackPanel>
            </Border>

            <!-- NVIDIA: picture and frame rate -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding IsNvidia, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="NVIDIA picture and frame rate" Style="{StaticResource Heading}" />
                    <TextBlock Text="Only the NVIDIA engine has these. The F1 menu in the game can change DLSS and frame generation while you play." Style="{StaticResource Caption}" Margin="0,4,0,12" />

                    <TextBlock Text="Resolution (Series X)" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="res" Content="Auto" IsChecked="{Binding ResolutionAuto, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="res" Content="1440p" IsChecked="{Binding Resolution1440, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="res" Content="1080p to 1440p" IsChecked="{Binding Resolution1080, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Foreground="{StaticResource Faint}"
                               Text="Auto: 1440p with DLSS, otherwise drawn at 1080p and brought up to 1440p, which is lighter on the card." />

                    <TextBlock Text="DLSS upscaling" Style="{StaticResource Caption}" Margin="0,18,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="dlss" Content="Off" IsChecked="{Binding DlssOff, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="dlss" Content="Quality" IsChecked="{Binding DlssQuality, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="dlss" Content="Balanced" IsChecked="{Binding DlssBalanced, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="dlss" Content="Performance" IsChecked="{Binding DlssPerformance, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock Text="Frame generation" Style="{StaticResource Caption}" Margin="0,18,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="fg" Content="Ready" IsChecked="{Binding FrameGenReady, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="fg" Content="Off" IsChecked="{Binding FrameGenOff, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="fg" Content="2x" IsChecked="{Binding FrameGen2x, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DlssNote}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                               Text="Ready: loaded but not drawing extra frames until switched on in the F1 menu. Frame generation sets aside 1.5 to 2 GB of the card's memory." />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="First-start warm-up" FontWeight="SemiBold" />
                            <TextBlock Text="A new engine build stays slow for its whole first run and is normal from the second. The launcher plays it for about 20 seconds once, closes it, and starts it again." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding WarmUp, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Preset -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Preset" Style="{StaticResource Heading}" Margin="0,0,0,12" />
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="preset" IsChecked="{Binding PresetAuto, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="Auto" FontWeight="SemiBold" />
                            <TextBlock Text="The engine's fast paths, with thread counts sized to this PC." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="preset" IsChecked="{Binding PresetSafe, Mode=TwoWay}">
                        <StackPanel>
                            <TextBlock Text="Safe" FontWeight="SemiBold" />
                            <TextBlock Text="Leaves out the newer, faster paths. Try it first when something is wrong." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="preset" IsChecked="{Binding PresetLow, Mode=TwoWay}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Low memory (experimental)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="The smaller console model, a texture budget, and levels made when needed, for small cards. It rendered a black picture on one RTX 4060 Laptop, so treat it as a test." />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Options" Style="{StaticResource Heading}" Margin="0,0,0,14" />

                    <TextBlock Text="Console model" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="console" Content="Series X" IsChecked="{Binding ConsoleX, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="console" Content="Series S" IsChecked="{Binding ConsoleS, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock Text="Threads that translate draw calls" Style="{StaticResource Caption}" Margin="0,18,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="threads" Content="Auto" IsChecked="{Binding Threads0, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="threads" Content="2" IsChecked="{Binding Threads2, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="threads" Content="4" IsChecked="{Binding Threads4, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="threads" Content="6" IsChecked="{Binding Threads6, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="threads" Content="8" IsChecked="{Binding Threads8, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AutoThreadsText}" Style="{StaticResource Caption}" Margin="0,6,0,0" Foreground="{StaticResource Faint}" />

                    <TextBlock Text="Texture budget, MB (0 for none)" Style="{StaticResource Caption}" Margin="0,18,0,6" />
                    <TextBox Text="{Binding TextureBudgetMb, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left" />

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ray tracing (RTX)" FontWeight="SemiBold" />
                            <TextBlock Text="The game's own ray tracing. Off, and best left off: on this engine it is slow and the picture breaks. An estimate stands in for the light." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding RayTracing, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ambient light stand-in" FontWeight="SemiBold" />
                            <TextBlock Text="An estimate of indirect light for when ray tracing is off. On unless you change it for the NVIDIA engine, off for AMD. If the picture goes white, turn it off." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AmbientLight, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Remember pipelines" FontWeight="SemiBold" />
                            <TextBlock Text="Writes down what the game draws with so Prepare can build it ahead next time." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding RecordPipelines, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="This PC" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Check again" Style="{StaticResource SecondaryButton}" Command="{Binding RecheckCommand}" Padding="12,6" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Checks}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Mark}" Foreground="{Binding Brush}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding FixLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding FixCommand}"
                                            Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Top"
                                            Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Transparency -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,24">
                <StackPanel>
                    <TextBlock Text="What Play runs" Style="{StaticResource Heading}" />
                    <TextBlock Text="The exact command and environment, so nothing is hidden." Style="{StaticResource Caption}" Margin="0,4,0,10" />
                    <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{Binding HostText}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    <Button Content="Forget what was learned" Style="{StaticResource LinkButton}" Command="{Binding ResetHostCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
