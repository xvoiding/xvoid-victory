<UserControl x:Class="Xvoid.Launcher.Views.PlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Overline}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding StateText}" Style="{StaticResource Overline}" />
            <TextBlock Text="{Binding GameName}" Style="{StaticResource Title}" Margin="0,4,0,2" />
            <TextBlock Style="{StaticResource Caption}">
                <Run Text="Engine" /> <Run Text="{Binding EngineLabel, Mode=OneWay}" />
            </TextBlock>

            <!-- The engine toggle: both engines are installed side by side, so either can be played. -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" IsEnabled="{Binding CanChoose}">
                <RadioButton Style="{StaticResource Segment}" GroupName="playEngine" Content="Auto" IsChecked="{Binding ChoiceAuto, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="playEngine" Content="NVIDIA" IsChecked="{Binding ChoiceNvidia, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="playEngine" Content="AMD" IsChecked="{Binding ChoiceAmd, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock Text="{Binding ChoiceHint}" Style="{StaticResource Caption}" Margin="2,6,0,0" Foreground="{StaticResource Faint}" />

            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Button Content="Play" Style="{StaticResource PrimaryButton}" Command="{Binding PlayCommand}" MinWidth="160"
                        Visibility="{Binding IsRunning, Converter={StaticResource NotToVis}}" />
                <Button Content="Stop" Style="{StaticResource SecondaryButton}" Command="{Binding StopCommand}" MinWidth="160" Padding="22,11"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="16,12" BorderBrush="{StaticResource Warn}"
                    Visibility="{Binding IsWarmingUp, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding WarmUpText}" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12" BorderBrush="{StaticResource Warn}"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Text}" />
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12" BorderBrush="{StaticResource Bad}"
                    Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="The last run ended" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Advice}" Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{StaticResource Text}" />
                </StackPanel>
            </Border>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="FPS" Style="{StaticResource TileLabel}" ToolTip="Frames per second. With frame generation: rendered, then shown." /><TextBlock Text="{Binding Fps}" Style="{StaticResource TileValue}" Margin="0,4,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="MS / FRAME" Style="{StaticResource TileLabel}" ToolTip="Milliseconds per frame" /><TextBlock Text="{Binding FrameTime}" Style="{StaticResource TileValue}" Margin="0,4,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="DRAWS" Style="{StaticResource TileLabel}" ToolTip="Draw calls per frame" /><TextBlock Text="{Binding Draws}" Style="{StaticResource TileValue}" Margin="0,4,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="MEMORY, GB" Style="{StaticResource TileLabel}" ToolTip="Memory held by the engine process, in GB" /><TextBlock Text="{Binding Memory}" Style="{StaticResource TileValue}" Margin="0,4,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel><TextBlock Text="COMMIT, GB" Style="{StaticResource TileLabel}" ToolTip="What Windows can still hand out (commit left), in GB" /><TextBlock Text="{Binding CommitLeft}" Style="{StaticResource TileValue}" Margin="0,4,0,0" /></StackPanel>
                </Border>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" Margin="2,10,0,0"
                       Text="Read from the engine while it runs. Memory is what the engine process holds. Commit is what Windows can still hand out; a run that reaches zero ends." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
