<UserControl x:Class="Xvoid.Launcher.Views.EnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Engine" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" MaxWidth="640"
                       Text="The engine is a separate program the launcher starts. There are two: NVIDIA's and AMD's. Both are installed side by side, so you can play whichever one runs better. Builds come from the project's GitHub releases and are checked against their SHA-256 before they are unpacked." />

            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Which engine" Style="{StaticResource Heading}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="engineKind" Content="Auto" IsChecked="{Binding ChoiceAuto, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="engineKind" Content="NVIDIA" IsChecked="{Binding ChoiceNvidia, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="engineKind" Content="AMD" IsChecked="{Binding ChoiceAmd, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ChoiceHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Foreground="{StaticResource Faint}"
                               Text="NVIDIA: tuned for GeForce cards, with DLSS and frame generation. AMD: the engine the Radeon cards were tuned on. Each keeps its own shader cache; saves are shared." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <RadioButton Style="{StaticResource Segment}" GroupName="src" Content="Released build" IsChecked="{Binding UseRelease, Mode=TwoWay}" Margin="0,0,0,0" HorizontalAlignment="Left" />
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding UseRelease, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Overline}"><Run Text="{Binding KindName, Mode=OneWay}" /><Run Text=" INSTALLED" /></TextBlock>
                                <TextBlock Text="{Binding Installed}" Style="{StaticResource Heading}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LATEST" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding Latest, TargetNullValue=Not checked}" Style="{StaticResource Heading}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,12,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Check for updates" Style="{StaticResource SecondaryButton}" Command="{Binding CheckCommand}" Margin="0,0,8,0" />
                            <Button Content="Install" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" Padding="22,9" />
                        </StackPanel>
                    </StackPanel>

                    <RadioButton Style="{StaticResource Segment}" GroupName="src" Content="Local build" IsChecked="{Binding UseLocal, Mode=TwoWay}" Margin="0,18,0,0" HorizontalAlignment="Left" />
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding UseLocal, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="For people who build the engine themselves (cargo build --release, target\release\victory.exe). It is used for whichever engine is chosen above.." Style="{StaticResource Caption}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LocalPath, Mode=OneWay}" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button Content="Open engines folder" Style="{StaticResource LinkButton}" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left" Margin="2,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
