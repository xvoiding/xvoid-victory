<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>xvoid-launcher</AssemblyName>
    <RootNamespace>Xvoid.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <ApplicationIcon>Assets\xvoid.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\xvoid.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Xvoid.Launcher.Core\Xvoid.Launcher.Core.csproj" />
  </ItemGroup>
</Project>
